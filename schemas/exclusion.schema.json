{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "exclusion",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "raw_record_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reason": {
      "enum": [
        "land",
        "parking",
        "no_doorplate",
        "invalid_date"
      ]
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "raw_record_id",
    "reason",
    "source_ref"
  ]
}
