# Configuration reference only. Scripts do not load .env automatically.
# Set variables in the process environment before running the scripts.
# Leave LVR_BATCH empty to parse all ZIP batches in data/raw/.
LVR_BATCH=

# Optional override for the bundled character-correction registry.
GARBLED_PATH=data/registry/garbled_override.csv

# Future offline lookup configuration. Not used by a pipeline entry point yet.
ADDR_DB_DIR=C:/Code/taiwan-address-data
