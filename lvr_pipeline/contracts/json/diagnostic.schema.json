{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "diagnostic",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "raw_record_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "code": {
      "type": "string",
      "minLength": 1
    },
    "detail": {
      "type": "string"
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "raw_record_id",
    "code",
    "detail",
    "source_ref"
  ]
}
